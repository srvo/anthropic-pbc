#!/bin/sh
# Block commits where the page embed or figures drifted from the paper.
# Unsealed drafts (pins lagging the paper hash) only warn; CI on main is strict.
# Enable once per clone: git config core.hooksPath .githooks
# Ruff lints every staged Python file (owner direction 2026-11-19). Reports only;
# autofix touched files with `ruff check --fix`.
pyfiles=$(git diff --cached --name-only --diff-filter=ACM -z -- '*.py' | xargs -0 -r -n1 printf '%s\n' | sed '/^$/d')
if [ -n "$pyfiles" ]; then
  echo "$pyfiles" | xargs -r ruff check --force-exclude || { echo "pre-commit: ruff failed" >&2; exit 1; }
fi
exec uv run --quiet scripts/seal.py check --allow-unsealed
