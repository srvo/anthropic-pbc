_file","mcp__claude_ai_Magic_Patterns__read_magic_patterns_design","mcp__claude_ai_Magic_Patterns__read_magic_patterns_design_files","mcp__claude_ai_Magic_Patterns__read_os_guide","mcp__claude_ai_Magic_Patterns__read_recent_message_history","mcp__claude_ai_Magic_Patterns__read_thread","mcp__claude_ai_Magic_Patterns__search_threads","mcp__claude_ai_Magic_Patterns__send_feedback_to_magic_patterns_team","mcp__claude_ai_Magic_Patterns__send_prompt","mcp__claude_ai_Magic_Patterns__set_os_file_layout","mcp__claude_ai_Magic_Patterns__set_status","mcp__claude_ai_Magic_Patterns__verify","mcp__claude_ai_Magic_Patterns__write_artifact_files","mcp__claude_ai_Magic_Patterns__write_design_system_files","mcp__claude_ai_Magic_Patterns__write_file","mcp__claude_ai_PostHog__authenticate","mcp__claude_ai_PostHog__complete_authentication","mcp__claude_ai_Rumor__get_account_status","mcp__claude_ai_Rumor__get_asset","mcp__claude_ai_Rumor__get_events","mcp__claude_ai_Rumor__get_financials","mcp__claude_ai_Rumor__get_news","mcp__claude_ai_Rumor__get_related","mcp__claude_ai_Rumor__get_summary","mcp__claude_ai_Rumor__get_timeseries","mcp__claude_ai_Rumor__get_trends","mcp__claude_ai_Rumor__list_news_publishers","mcp__claude_ai_Rumor__screen_assets","mcp__claude_ai_Rumor__search_assets","mcp__claude_ai_Supabase__apply_migration","mcp__claude_ai_Supabase__create_branch","mcp__claude_ai_Supabase__create_edge_function_secret","mcp__claude_ai_Supabase__create_project","mcp__claude_ai_Supabase__delete_branch","mcp__claude_ai_Supabase__delete_feedback","mcp__claude_ai_Supabase__deploy_edge_function","mcp__claude_ai_Supabase__execute_sql","mcp__claude_ai_Supabase__generate_typescript_types","mcp__claude_ai_Supabase__get_advisors","mcp__claude_ai_Supabase__get_edge_function","mcp__claude_ai_Supabase__get_organization","mcp__claude_ai_Supabase__get_project","mcp__claude_ai_Supabase__get_project_url","mcp__claude_ai_Supabase__get_publishable_keys","mcp__claude_ai_Supabase__list_branches","mcp__claude_ai_Supabase__list_edge_functions","mcp__claude_ai_Supabase__list_extensions","mcp__claude_ai_Supabase__list_migrations","mcp__claude_ai_Supabase__list_organizations","mcp__claude_ai_Supabase__list_projects","mcp__claude_ai_Supabase__list_tables","mcp__claude_ai_Supabase__merge_branch","mcp__claude_ai_Supabase__pause_project","mcp__claude_ai_Supabase__query_logs","mcp__claude_ai_Supabase__rebase_branch","mcp__claude_ai_Supabase__reset_branch","mcp__claude_ai_Supabase__restore_project","mcp__claude_ai_Supabase__search_docs","mcp__claude_ai_Supabase__submit_feedback","mcp__honcho__honcho_ask","mcp__honcho__honcho_conclusions","mcp__honcho__honcho_list","mcp__honcho__honcho_peer_card","mcp__honcho__honcho_remember","mcp__honcho__honcho_representation","mcp__honcho__honcho_search","mcp__tinyfish__batch_cancel","mcp__tinyfish__batch_status","mcp__tinyfish__cancel_dataset_run","mcp__tinyfish__cancel_deep_research","mcp__tinyfish__cancel_monitor","mcp__tinyfish__cancel_profile_setup_session","mcp__tinyfish__cancel_run","mcp__tinyfish__close_browser_session","mcp__tinyfish__create_browser_session","mcp__tinyfish__create_dataset","mcp__tinyfish__create_monitor","mcp__tinyfish__create_profile","mcp__tinyfish__delete_dataset","mcp__tinyfish__fetch_content","mcp__tinyfish__get_dataset","mcp__tinyfish__get_dataset_rows","mcp__tinyfish__get_deep_research","mcp__tinyfish__get_monitor","mcp__tinyfish__get_run","mcp__tinyfish__get_search_usage","mcp__tinyfish__get_wallet","mcp__tinyfish__guide_next_step","mcp__tinyfish__list_browser_sessions","mcp__tinyfish__list_datasets","mcp__tinyfish__list_deep_research","mcp__tinyfish__list_fetch_usage","mcp__tinyfish__list_monitors","mcp__tinyfish__list_profiles","mcp__tinyfish__list_runs","mcp__tinyfish__pause_monitor","mcp__tinyfish__plan_dataset","mcp__tinyfish__populate_dataset","mcp__tinyfish__resume_monitor","mcp__tinyfish__run_monitor","mcp__tinyfish__run_web_automation","mcp__tinyfish__run_web_automation_async","mcp__tinyfish__save_profile_setup_session","mcp__tinyfish__search","mcp__tinyfish__start_deep_research","mcp__tinyfish__start_profile_setup_session","mcp__tinyfish__top_up_wallet"],"removedNames":[],"wireHiddenNames":[],"readdedNames":[],"surfacedNames":["mcp__claude_ai_Claude_Docs__batch","mcp__claude_ai_Claude_Docs__guide","mcp__claude_ai_Claude_Docs__update","mcp__claude_ai_Granola__get_meeting_transcript","mcp__claude_ai_Granola__get_meetings","mcp__claude_ai_Granola__query_granola_meetings","mcp__claude_ai_Granola__search_meetings","mcp__claude_ai_Granola__search_transcripts"],"surfacedDefinitions":[{"name":"mcp__claude_ai_Claude_Docs__batch","listing":"b18caec4513bd82d","definition":{"name":"mcp__claude_ai_Claude_Docs__batch","description":"Create a doc, or apply several operations to one doc atomically.","input_schema":{"type":"object","properties":{"batch":{"type":"array"},"container":{"type":"object","properties":{"kind":{"type":"string"},"id":{"type":"string"},"create":{"type":"object"}},"required":["kind"]},"verbose":{"type":"boolean"},"opId":{"type":"string"}}},"eager_input_streaming":true}},{"name":"mcp__claude_ai_Claude_Docs__guide","listing":"1f2c30a590811b06","definition":{"name":"mcp__claude_ai_Claude_Docs__guide","description":"Docs guides: topic.instructions repeats the server instructions. Read it only if your client dropped them. Also topic.<name>, refusal.<code>. After a doc's birth → [\"topic.index\"].","input_schema":{"type":"object","properties":{"items":{"type":"array","description":"topic.<name> (instructions, index, editing, tabs, comments, charts, chart-definition, diagram, uploads, sharing, skill) or refusal.<code>; several per call is fine."}}},"eager_input_streaming":true}},{"name":"mcp__claude_ai_Claude_Docs__update","listing":"b1347b8d2c5727e2","definition":{"name":"mcp__claude_ai_Claude_Docs__update","description":"Edit a tab's contents, rename a doc or tab, or change a stored value.","input_schema":{"type":"object","properties":{"ref":{"type":"object","properties":{"object":{"type":"string","enum":["project","file","node","utterance","enum"]},"id":{"type":"string"}},"required":["object","id"]},"engine":{"type":"string"},"payload":{"anyOf":[{"type":"object"},{"type":"string"}]},"container":{"type":"object","properties":{"kind":{"type":"string"},"id":{"type":"string"},"version":{"type":"string"}},"required":["kind","id"]},"verbose":{"type":"boolean"},"opId":{"type":"string"},"answering":{"type":"string","maxLength":64}},"required":["ref","payload"]},"eager_input_streaming":true}},{"name":"mcp__claude_ai_Granola__get_meeting_transcript","listing":"610fa9c823f770bf","definition":{"name":"mcp__claude_ai_Granola__get_meeting_transcript","description":"Get the verbatim transcript of a Granola meeting by ID; no summaries or notes.\nReturns up to 40000 characters per call by default (max_chars, up to 80000), cut at an utterance boundary with total_chars, truncated and next_offset reported. A page that splits an oversized utterance has ends_mid_utterance and the next starts_mid_utterance.\nWith meeting_ids, meetings has one entry per requested ID in request order, with the single-read fields or an error. The batch shares 80000 characters: each meeting returns up to max_chars or an equal share of that, whichever is smaller. Pass offsets to continue several meetings in one call.\nAn accessible meeting with no transcript returns transcript null (status \"unavailable\" for chunk reads) and transcript_unavailable with a reason: transcript_pending means retry in a few minutes; not_happened_yet means retry after the meeting; no_transcript and transcript_deleted are final. \"Meeting not found\" means the ID does not resolve or is not accessible.\nTranscript blocks separate audio source (Microphone/System audio) from speaker identity; mobile/imported transcripts may keep Speaker A/B labels. For native recordings, recording context identifies the document owner as the recorder, not necessarily the speaker; missing recorder data stays unknown.\nNeeds a paid Granola plan. If it returns a paid-plan error, use the other meeting tools and say when their results lack the requested detail.","input_schema":{"type":"object","properties":{"meeting_ids":{"description":"Meeting UUIDs or public note IDs (max 10). With several IDs, offset applies to each meeting and the meetings share 80000 characters, so each returns up to max_chars or an equal share, whichever is smaller; use offsets to start meetings at different positions. A meeting that cannot be read gets an error entry and the others are still returned. Empty arrays are ignored.","maxItems":10,"type":"array","items":{"type":"string"}},"note_ids":{"description":"Alias for meeting_ids. If both are nonempty, they must refer to the same set of notes; order, duplicates, and UUID/public ID format may differ.","maxItems":10,"type":"array","items":{"type":"string"}},"meeting_id":{"description":"Alias for meeting_ids with a single meeting. Every ID argument provided must name the same meetings.","type":"string"},"note_id":{"description":"Alias for meeting_ids with a single meeting. Every ID argument provided must name the same meetings.","type":"string"},"offset":{"description":"Character offset; pass next_offset to continue, with the same include_timestamps as that page.","type":"integer","minimum":0,"maximum":9007199254740991},"max_chars":{"description":"Maximum size of the transcript field as sent (integer, at least 1,000), cut at the last utterance that fits; a page holds fewer transcript characters when the text needs JSON escaping. Defaults to 40000; larger requests are capped at 80000. Use next_offset to continue. Lower it if responses exceed your output limit.","type":"integer","minimum":1000,"maximum":9007199254740991},"include_timestamps":{"description":"Prefix each reliably timed block with [m:ss], minutes:seconds since the transcript's earliest timed block, not clock time; that block can predate the meeting when recording started early. Applies to every page; chunk_ids reads always include them. Adds about 7 characters per block, and offset, next_offset and total_chars count the text as rendered with it, so keep the same value when continuing from next_offset. When no block has timing, no prefixes are added and timestamps_unavailable says so.","type":"boolean"},"offsets":{"description":"With meeting_ids only: character offset per meeting, keyed by meeting ID, e.g. {\"<id>\": 8000}. Pass each truncated meeting's next_offset to continue several transcripts in one call. Meetings not listed start at offset. Omit or pass {} when not needed.","type":"object","propertyNames":{"type":"string"},"additionalProperties":{"type":"integer","minimum":0,"maximum":9007199254740991}},"chunk_ids":{"description":"Read up to ten finalized transcript chunks instead of the full transcript. Use chunk IDs from search_transcripts, or [0] to browse from the beginning. IDs past the last chunk are skipped and listed in ignored_chunk_ids; if none of the IDs exist the status is out_of_range. Each chunk's transcript is verbatim text in the full read's format: one block per speaker turn, prefixed with [m:ss] (minutes:seconds since the transcript's earliest timed block, omitted when unknown) and the speaker label; preformatted transcripts keep their own text and labels. Also returns total_chunks and previous/next chunk IDs.","minItems":1,"maxItems":10,"type":"array","items":{"type":"integer","minimum":0,"maximum":9007199254740991}},"transcript_version":{"description":"With chunk_ids, reuse the version from search or a previous chunk read. A changed status returns no chunks: search again or restart browsing without the old version. Omit chunk_ids and transcript_version for the existing full transcript read.","type":"string","minLength":1,"maxLength":200}}},"eager_input_streaming":true}},{"name":"mcp__claude_ai_Granola__get_meetings","listing":"6e15a59d0f69a5ed","definition":{"name":"mcp__claude_ai_Granola__get_meetings","description":"Read one or more Granola meetings by ID: private notes, AI summary, attendees, metadata and note URLs. Use it when you have meeting IDs from discovery results or note URLs; batch up to 10 IDs per call.\nPrivate notes appear only for meetings the user owns (status \"empty\": no text; \"not_included\": another user owns the note).\nmeeting_at is the calendar event's scheduled start (created_at without an event), so it can differ from when the meeting was recorded.\nInvalid, missing and inaccessible IDs are reported separately; the other meetings are still returned.\nIf the meetings would exceed 80000 characters, the last ones are left out and listed in omitted_meetings; read them in another call.\nThe note creator and participants are not necessarily the connected user: confirm the connected user's identity with get_account_info and match it to explicit ownership evidence before drafting in the user's voice or assigning them actions; first-person notes are not proof of the user's voice. Dated plans do not establish current progress.\nknown_participants comes from the calendar invite, attendees added by hand, and the note creator; anyone else who spoke appears only in the notes and transcript.\nDoes not return transcripts; notes can omit details that were discussed. If a detail is missing, get_meeting_transcript may have it on a paid Granola plan; if it returns a paid-plan error, say the detail is missing rather than conclude it was never discussed.\nShared-screen screenshots appear in <attachments> with an ID, time offset and lossy description; for anything visual (designs, slides, charts, code), view them with get_meeting_attachment.\nAttached photos appear as <attachment type=\"photo\"> without a description; view them with get_meeting_attachment.\nKeep at most 5 get_meetings calls in flight, and only for calls you already need. On a rate_limit error, retry only the failed call after retry_after_seconds, one at a time, and not when retryable is false.","input_schema":{"type":"object","properties":{"meeting_ids":{"description":"Meeting UUIDs, public note IDs (not_...) or upcoming-meeting IDs (evt_...) (max 10). Provide at least one ID in meeting_ids or note_ids; empty arrays are ignored.","maxItems":10,"type":"array","items":{"type":"string"}},"note_ids":{"description":"Alias for meeting_ids. Empty arrays are ignored. If both are nonempty, they must refer to the same set of notes; order, duplicates, and UUID/public ID format may differ.","maxItems":10,"type":"array","items":{"type":"string"}},"max_participants":{"description":"Maximum attendees to list per meeting, besides the note creator. Omit to list everyone. Set a small value (e.g. 10) for broad ranges or large meetings to keep responses small. When attendees are left out, known_participants has total and omitted attributes, e.g. <known_participants total=\"250\" omitted=\"240\">.","type":"integer","minimum":0,"maximum":9007199254740991},"attachments":{"description":"Omit or pass \"list\" to list each meeting's viewable attachments with their IDs; when several meetings are returned, only the first 20 per meeting are listed and the attachments element says how many were left out. Pass \"count\" to get only an attachment_count attribute on each meeting that has attachments. Pass \"none\" to leave attachments out.","type":"string","enum":["list","count","none"]}},"additionalProperties":false},"eager_input_streaming":true}},{"name":"mcp__claude_ai_Granola__query_granola_meetings","listing":"f856a55634c53b7a","definition":{"name":"mcp__claude_ai_Granola__query_granola_meetings","description":"Query Granola about the user's meetings in natural language. Returns an answer with inline markdown citation links (e.g. [[1]](url)) to the source meeting notes; keep them in your response so the user can verify it. The citation URL https://notes.granola.ai/d/<meeting_id> gives the ID to pass to get_meetings (meeting_ids).\n\nThe answer is a summary that can leave out owners, numbers, dates and exact wording; when the question asks for those, read the cited meetings with get_meetings first.\n\nThis tool is slow: an agent behind it searches and reads the user's notes. Prefer a faster tool when it can answer:\n- Meeting discovery tools: find meetings by date range\n- get_meetings: read notes for meetings whose IDs you already have\n- search_meetings: find meetings by keyword, participant or company\n\nUse it for what was discussed, decided or assigned across meetings, follow-ups and commitments, or when the user references their 'Granola notes'.\n\nWhen NOT to use:\n- Scheduling meetings or changing calendar invites\n- A specific meeting by ID: use get_meetings\n\nTranscripts need a paid Granola plan. If get_meeting_transcript returns a paid-plan error and results lack a detail, say so rather than conclude it was never discussed.\nKeep at most 15 query_granola_meetings calls in flight, and only for calls you already need. On a rate_limit error, retry only the failed call after retry_after_seconds, one at a time, and not when retryable is false.","input_schema":{"type":"object","properties":{"query":{"type":"string","minLength":1,"description":"The query to run on Granola meeting notes"},"document_ids":{"description":"Optional meeting UUIDs or public note IDs to limit context to (max 10).","maxItems":10,"type":"array","items":{"type":"string","description":"Meeting UUID, public note ID (not_...) or Granola note link"}},"note_ids":{"description":"Alias for document_ids (max 10). If both are provided, they must refer to the same set of notes; order, duplicates, and UUID/public ID format may differ.","maxItems":10,"type":"array","items":{"type":"string","description":"Meeting UUID, public note ID (not_...) or Granola note link"}}},"required":["query"],"additionalProperties":false},"eager_input_streaming":true}},{"name":"mcp__claude_ai_Granola__search_meetings","listing":"eaf55b1f616a8517","definition":{"name":"mcp__claude_ai_Granola__search_meetings","description":"Find the user's meetings by keyword, participant/company, date, or a combination. Keyword searches cover meeting titles, summaries and your private notes. They do not search transcripts: an empty result does not mean a term was never spoken in a meeting. Returns metadata only (title, date, participants, note headings), not what was said: read the relevant meetings with get_meetings before answering about their content, and use get_meetings directly for a meeting you already identified. With keywords or participant, results are ranked by relevance favouring recent meetings; with neither, newest first, defaulting to the last 7 days.\n\nPass next_cursor as cursor with the same filters to continue; pages can be short or empty, so continue while next_cursor is present. completion_status incomplete means continuation is unavailable: narrow the search.\n\nWhen the searched dates reach past now, the first page starts with upcoming_meetings (not part of cursor pagination): up to limit (at most 50) matching calendar meetings in the next 14 days, soonest first, matched on their titles, attendees and organizer, and the user's notes for them. Each is listed only there until it ends or is summarized, under an evt_ ID that works as a meeting ID in other tools. When more match, it has next_from: call again with from_date set to it.\n\nparticipant matches participant metadata (names, emails, companies, domains), not mentions in notes, as an AND filter with the other inputs; metadata can be incomplete. For broader questions about a person or company, also search their name plus the topic in keywords with participant omitted: internal discussions may hold the answer.\n\nCaptures of the same calendar event are grouped, keeping the user's own note or else the newest; read other_ids in duplicate_recordings only for details the listed note lacks or when the user asks to compare attendees' notes. Use attended_only=true for 'my meetings'. list_meeting_folders gives folder_id values. Keyword matching is literal, so pass the user's words plus obvious synonyms. Meetings with viewable attachments carry an attachment_count attribute; get_meetings lists them.\nKeep at most 2 search_meetings calls in flight, and only for calls you already need. On a rate_limit error, retry only the failed call after retry_after_seconds, one at a time, and not when retryable is false.","input_schema":{"type":"object","properties":{"cursor":{"description":"Opaque next_cursor from the previous response. Omit filters to reuse them, or repeat the same filters. Omit cursor or pass an empty string for the first page. Cursors expire after 15 minutes.","type":"string","maxLength":2048},"folder_id":{"description":"Only return meetings in this folder or its nested folders. Use list_meeting_folders to discover folder IDs.","type":"string"},"workspace_only":{"description":"Set to true only when the user explicitly asks for Team Space, public workspace, or workspace-visible meetings. Omit or set to false to search every meeting the user is allowed to access. Combines with folder_id and include_shared using AND.","type":"boolean"},"keywords":{"description":"Groups of words to search for in meeting titles, summaries, or your private notes. Transcript text is not searched. All words in one entry must appear within the same field, in any order or position. Entries are alternatives (OR): [\"MCP write tools\"] requires all three words; [\"write tools\", \"write access\"] matches either group. Pass at most 20 entries. Adjacent words in the supplied order get a relevance boost, but exact phrases are not required. A single comma-separated string is also accepted. Omit to browse meetings by date.","minItems":1,"maxItems":20,"type":"array","items":{"type":"string","minLength":1}},"max_participants":{"description":"Maximum attendees to list per meeting, besides the note creator. Omit to list everyone. Set a small value (e.g. 10) for broad ranges or large meetings to keep responses small. When attendees are left out, known_participants has total and omitted attributes, e.g. <known_participants total=\"250\" omitted=\"240\">.","type":"integer","minimum":0,"maximum":9007199254740991},"participant":{"description":"Filter meetings with a participant name, email, company name, or domain in participant metadata. Combines with keywords, dates, and folder using AND. Mentions in notes alone do not match; missing participant metadata can hide relevant meetings. For broader questions about their work, account status, decisions, issue resolution, or preparation, also search the person/company and topic in keywords without this filter to include internal discussions.","type":"string","maxLength":200},"limit":{"description":"Requested meetings per page (positive integer). Defaults to 30 and is capped at 100. Larger requests use the cap; use next_cursor to continue. Duplicates or inaccessible matches can make a page shorter.","type":"integer","minimum":1,"maximum":9007199254740991},"attended_only":{"description":"Only notes the user captured or where their email is listed as a creator or attendee. Approximates attendance; defaults to false.","type":"boolean"},"include_shared":{"description":"Also search notes other people shared with the user. Defaults to true when omitted.","type":"boolean"},"from_date":{"description":"Only meetings on or after this ISO date or time, using calendar start when available, otherwise note creation. Dates and offsetless times use the user's timezone (UTC if unavailable); explicit offsets are respected, so for a day in another timezone give both bounds as times with that timezone's offset.","type":"string"},"to_date":{"description":"Only meetings on or before this ISO date or time. YYYY-MM-DD includes the whole day in the user's timezone (UTC if unavailable); explicit offsets are respected. Uses calendar start when available, otherwise note creation.","type":"string"},"updated_after":{"description":"Only notes whose summary or content changed after this ISO date or time; matching rows then show updated_at. Use it to pick up changes since a previous call. Combines with the other filters using AND; without from_date and to_date it covers all accessible meeting history (the last 30 days on the free plan) instead of the last 7 days. Offsetless values use the user's timezone (UTC if unavailable).","type":"string"}}},"eager_input_streaming":true}},{"name":"mcp__claude_ai_Granola__search_transcripts","listing":"264678efb666f3e4","definition":{"name":"mcp__claude_ai_Granola__search_transcripts","description":"Find specific words or quotes in accessible meeting transcripts in the active workspace. Returns ranked passages with approximate timestamps.\n\nNeeds a paid Granola plan. If it returns a paid-plan error, use the other meeting tools.\n\nSupply meeting_ids when known, batching meetings that share the same terms and filters. Matching is literal; put alternative words in one keywords array, e.g. [\"pricing\", \"price\", \"cost\"]. For what a person or company said, use participant (names/companies) or attendee_emails/attendee_domains (invite list). participant is an AND filter on metadata that can be incomplete, so for broader questions also search their name and the topic in keywords without it.\n\nKnown meetings with no indexed match are also searched in their current transcripts. Without meeting_ids, search relies on an asynchronously updated index and groups duplicate recordings; empty results do not prove a topic was never discussed.\n\nFollow next_cursor even on empty pages, passing only cursor and optionally limit. If completion_status is incomplete, narrow the search or read known transcripts.\n\nRead surrounding dialogue with get_meeting_transcript using meeting_id, the passage's chunk_ids and transcript_version; adjacent chunk IDs continue, and omitting chunk_ids reads the whole conversation.\n\ncounts is cumulative across pages; total_matching_chunks is a first-page estimate, null for direct search. Neither counts spoken mentions.\n\nUse another tool when:\n- The term is likely in the notes, or the user wants meetings about a topic: use search_meetings\n- You need the whole conversation: use get_meeting_transcript","input_schema":{"type":"object","properties":{"keywords":{"description":"Required for a new search. Entries are alternatives (OR); all words within an entry must occur in one chunk, in any order. Accepts an array or comma-separated string.","minItems":1,"maxItems":20,"type":"array","items":{"type":"string","minLength":1,"maxLength":100}},"meeting_ids":{"description":"Restrict to these meetings (UUIDs or public note IDs, max 100). Batch IDs sharing the same terms and filters. Omit to search all accessible indexed meetings.","minItems":1,"maxItems":100,"type":"array","items":{"type":"string","description":"Meeting UUID, public note ID (not_...) or Granola note link"}},"cursor":{"description":"Pass next_cursor from a previous result; only limit may accompany it. Omit or pass an empty string for the first page. Cursors expire after 15 minutes.","type":"string"},"limit":{"description":"Passages per page with meeting_ids; otherwise meetings per page. Default 10, capped at 20.","type":"integer","minimum":1,"maximum":9007199254740991},"from_date":{"description":"Only meetings on or after this ISO date or time, using calendar start when available, otherwise note creation. Dates and offsetless times use the user's timezone (UTC if unavailable).","type":"string"},"to_date":{"description":"Only meetings on or before this ISO date or time. YYYY-MM-DD includes the whole day in the user's timezone (UTC if unavailable). Uses calendar start when available, otherwise note creation.","type":"string"},"participant":{"description":"Filter by participant name, email, company name, or domain in meeting participant metadata. Combines with keywords, dates, meeting_ids, attendee_emails, and attendee_domains using AND. Mentions in the transcript alone do not match. Missing participant metadata can hide relevant meetings; metadata does not prove attendance.","type":"string","maxLength":200},"attendee_emails":{"description":"Only meetings whose invite list includes any of these emails, e.g. [\"alice@acme.com\"]","minItems":1,"maxItems":20,"type":"array","items":{"type":"string"}},"attendee_domains":{"description":"Only meetings whose invite list includes anyone at these email domains, including subdomains, e.g. [\"acme.com\"]","minItems":1,"maxItems":20,"type":"array","items":{"type":"string"}}}},"eager_input_streaming":true}}]},"type":"attachment","uuid":"b98b381c-dd57-4266-b945-4c8c851e7206","timestamp":"2026-11-05T05:59:59.374Z","rendered":[{"content":"<system-reminder>\nThe following tools just became available and are ready to use:\nmcp__claude_ai_Claude_Docs__batch\nmcp__claude_ai_Claude_Docs__guide\nmcp__claude_ai_Claude_Docs__update\nmcp__claude_ai_Granola__get_meeting_transcript\nmcp__claude_ai_Granola__get_meetings\nmcp__claude_ai_Granola__query_granola_meetings\nmcp__claude_ai_Granola__search_meetings\nmcp__claude_ai_Granola__search_transcripts\n\nThe following deferred tools are now available via ToolSearch. Their schemas are NOT loaded — calling them directly will fail with InputValidationError. Use ToolSearch with query \"select:<name>[,<name>...]\" to load tool schemas before calling them:\nArtifactComments\nArtifactData\nCronCreate\nCronDelete\nCronList\nDesignSync\nEndConversation\nEnterPlanMode\nEnterWorktree\nExitPlanMode\nExitWorktree\nLSP\nListMcpResourcesTool\nMonitor\nNotebookEdit\nPushNotification\nReadMcpResourceDirTool\nReadMcpResourceTool\nRemoteTrigger\nSendMessage\nSendToProject\nSendToProjectContext\nTaskStop\nWebFetch\nWebSearch\nmcp__claude-in-chrome__browser_batch\nmcp__claude-in-chrome__computer\nmcp__claude-in-chrome__file_upload\nmcp__claude-in-chrome__find\nmcp__claude-in-chrome__form_input\nmcp__claude-in-chrome__get_page_text\nmcp__claude-in-chrome__gif_creator\nmcp__claude-in-chrome__javascript_tool\nmc